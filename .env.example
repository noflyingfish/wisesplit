# Copy this file to `config/deploy.yml` before running anything Prisma-related:
#
#   cp config/deploy.example.yml config/deploy.yml      (bash)
#   copy config\deploy.example.yml config\deploy.yml    (cmd / PowerShell)
#
# `config/deploy.yml` is gitignored (see `.gitignore`), so a fresh clone has no
# database configuration until this file is copied. It is the single file you edit
# — profiles, database, and later TLS/domain/backups. Read the comments in it.
#
# This `.env` file holds SECRETS ONLY. It exists so credentials need not live in
# the config file, which is easier to share and to commit a template of. Values
# referenced as `${NAME}` from `config/deploy.yml` are read from here (or from the
# real environment, which wins).
#
# Do NOT put DATABASE_URL here. Which database is live is decided by the active
# profile in `config/deploy.yml`; a second DATABASE_URL is a second source of
# truth for that, and the loader warns when it finds one.

# Password for the `wisesplit_app` MariaDB user — the value behind
# `password: ${WISESPLIT_DB_PASSWORD}` in config/deploy.yml.
#
# On a server, set this in the real environment instead of in a file:
#   WISESPLIT_DB_PASSWORD=... npm start
WISESPLIT_DB_PASSWORD=change-me

# Used only by the `prod` profile in config/deploy.yml.
# WISESPLIT_DB_HOST=db.example.com
# WISESPLIT_DB_PORT=3306
# WISESPLIT_DB_NAME=wisesplit
# WISESPLIT_DB_USER=wisesplit_app
